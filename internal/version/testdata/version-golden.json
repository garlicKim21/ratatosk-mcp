  "known_divergence": {
    "_why": [
      "SplitLine takes the longest prefix ending in / @ - whose remainder merely STARTS with a digit.",
      "A numeric-leading pre-release or build tail therefore gets eaten as if it were a release line,",
      "and the key is then read out of the tail instead of the core version:",
      "  1.36.5-1768567475-9f2b1c3  ->  line \"1.36.5-1768567475\", key [9]",
      "  2.0.0-1                    ->  line \"2.0.0\",            key [1]",
      "A line prefix that is itself a version number is nonsense, and [9] is not 1.36.5.",
      "Measured 2026-08-13: no tag of this shape exists in raw_releases (831 rows, 9 distinct shapes),",
      "so nothing is mis-sorted in production today — this is latent, not live. Left as-is because",
      "changing NormalizeVersion changes stored version_key values and needs a backfill decision.",
      "These entries pin CURRENT behaviour so the three copies stay identical; they are not the",
      "answers we want. Fixing the rule means changing this section and all three implementations."
    ],
    "normalize": [
      { "raw": "1.36.5-1768567475-9f2b1c3", "key": [9], "note": "want [1,36,5]" },
      { "raw": "1.36.5-1768567475", "key": [1768567475], "note": "want [1,36,5]" },
      { "raw": "2.0.0-1", "key": [1], "note": "want [2,0,0] — Debian-style revision suffix" },
      { "raw": "v1.2.3-20260101", "key": [20260101], "note": "want [1,2,3] — dated build" },
      { "raw": "1.2.3-0", "key": [0], "note": "want [1,2,3]" }
    ],
    "split_line": [
      { "raw": "1.36.5-1768567475-9f2b1c3", "line": "1.36.5-1768567475", "rest": "9f2b1c3", "note": "want line \"\"" },
      { "raw": "1.36.5-1768567475", "line": "1.36.5", "rest": "1768567475", "note": "want line \"\"" },
      { "raw": "2.0.0-1", "line": "2.0.0", "rest": "1", "note": "want line \"\"" },
      { "raw": "v1.2.3-20260101", "line": "v1.2.3", "rest": "20260101", "note": "want line \"\"" },
      { "raw": "1.2.3-0", "line": "1.2.3", "rest": "0", "note": "want line \"\"" }
    ]
  }
